<mvc:View controllerName="zcnhrmecn_ta01.controller.Master" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m"
	xmlns:semantic="sap.m.semantic">
	<semantic:MasterPage id="page" title="{masterView>/title}" navButtonPress="onNavHome" showNavButton="true">
		<semantic:subHeader>
			<Bar id="headerBar">
				<contentMiddle>
					<SearchField id="searchField" showRefreshButton="{= !${device>/support/touch} }" tooltip="{i18n>masterSearchTooltip}" width="100%"
						search="onSearch"></SearchField>
				</contentMiddle>
			</Bar>
		</semantic:subHeader>
		<semantic:content>
			<PullToRefresh id="pullToRefresh" visible="{device>/support/touch}" refresh="onRefresh"/>
			<!-- For client side filtering add this to the items attribute:  parameters: {operationMode: 'Client'}}" -->
			<List id="List" updateFinished="onUpdateFinished" noDataText="{i18n>NoRecord}" growing="true" growingScrollToLoad="false"
				growingThreshold="25" selectionChange="onNavApprove" mode="{= ${device>/system/phone} ? 'None' : 'SingleSelectMaster'}">
				<ObjectListItem id="ObjectListItem" title="{parts :['Nachn','Vorna','Rufnm'], formatter:'._formatName'}"
					type="{= ${device>/system/phone} ? 'Active' : 'Inactive'}" press="onNavApprove" number="{Stdaz}" numberUnit="{i18n>Hours}">
					<firstStatus>
						<ObjectStatus text="{StatsDes}" state="{parts :['Stats'], formatter:'._formatText'}"/>
					</firstStatus>
					<attributes>
						<ObjectAttribute text="{Zlvde}"/>
						<ObjectAttribute
							text="{path: 'Begda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }} - {path: 'Endda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }}"/>
						<ObjectAttribute
							text="{path: 'Beguz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }} - {path: 'Enduz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"/>
					</attributes>
				</ObjectListItem>
			</List>
		</semantic:content>
	</semantic:MasterPage>
</mvc:View>