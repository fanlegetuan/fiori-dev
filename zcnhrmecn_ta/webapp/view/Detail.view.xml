<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:semantic="sap.m.semantic" xmlns:f="sap.ui.layout.form"
	xmlns:html="http://www.w3.org/1999/xhtml" xmlns:l="sap.ui.layout" xmlns:c="sap.suite.ui.commons"
	controllerName="zcnhrmecn_ta.controller.Detail" viewName="edit">
	<semantic:DetailPage id="page" title="{i18n>RequestDetail}" navButtonPress="onNavBack" showNavButton="true" busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}">
		<semantic:content>
			<ObjectHeader id="historyHeader" responsive="true" intro="{i18n>LeaveDetailinfo}" icon="sap-icon://detail-view" title="{Reqno}"
				backgroundDesign="Translucent">
				<attributes>
					<ObjectAttribute title="{i18n>EmployeeNumber}" text="{Pernr}"/>
					<!--<ObjectAttribute title="{i18n>StartDate}" text="{path: 'Begda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }}"/>-->
					<!--<ObjectAttribute title="{i18n>EndDate}" text="{path: 'Endda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }}"/>-->
					<ObjectAttribute title="{i18n>EmployeeName}" text="{parts :['Nachn','Vorna','Rufnm'], formatter:'._formatName'}"/>
					<!--<ObjectAttribute title="{i18n>StartTime}"-->
					<!--	text="{path: 'Beguz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"/>-->
					<!--<ObjectAttribute title="{i18n>EndTime}"-->
					<!--	text="{path: 'Enduz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"/>-->
					<!--<ObjectAttribute title="{i18n>CorrDesc}" text="{AtypeDes}"/>-->
					<!--<ObjectAttribute title="{i18n>LeaveType}" text="{Zlvde}"/>-->
					<!--<ObjectAttribute title="{i18n>AbsenceHour}" text="{Stdaz}"/>-->
				</attributes>
				<statuses>
					<ObjectStatus id="objectStatus" title="{i18n>Status}" text="{parts :['StatsDes','Stats'], formatter:'._formatStatusText'}"/>
				</statuses>
				<headerContainer>
					<IconTabBar id="idIconTabBar" expanded="true" class="sapUiResponsiveContentPadding">
						<items>
							<IconTabFilter icon="sap-icon://activity-items" text="{i18n>General}">
								<Label class="sapUiSmallMarginBegin sapUiSmallMarginTop fontsize" text="{i18n>RequestNote}"/>
								<List showSeparators="Inner">
									<FeedListItem sender="{parts :['Nachn','Vorna','Rufnm'], formatter:'._formatName'}" icon="sap-icon://person-placeholder"
										timestamp="{path: 'Aedtm', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }} {path: 'Aenzt', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"
										iconDensityAware="false" info="{Zlvde}" text="{Znote}"/>
								</List>
								<List showSeparators="Inner" items="{headerToApproavl}">
									<FeedListItem sender="{parts :['NachnMgr','VornaMgr','Mgrnm'], formatter:'._formatName'}" icon="sap-icon://visits" iconDensityAware="false"
										info="{parts :['StatsDes','Stats'], formatter:'._formatStatusText'}"
										timestamp="{path: 'Aedtm', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }} {path: 'Aenzt', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"
										text="{Znote}"/>
								</List>
							</IconTabFilter>
							<IconTabFilter icon="sap-icon://list" text="{i18n>ItemList}">
								<Table id="ItemList" mode="SingleSelectLeft" items="{headerToItem}">
									<columns>
										<Column width="12rem">
											<Text text="{i18n>RequestNumber}"/>
										</Column>
										<Column width="6rem" visible="{= !${device>/system/phone} }">
											<Text text="{i18n>CorrDesc}"/>
										</Column>
										<Column width="6rem">
											<Text text="{i18n>Shift}"/>
										</Column>
										<Column width="6rem">
											<Text text="{i18n>ShiftDesc}"/>
										</Column>
										<Column width="6rem" visible="{= !${device>/system/phone} }">
											<Text text="{i18n>StartDate}"/>
										</Column>
										<Column width="6rem" visible="{= !${device>/system/phone} }">
											<Text text="{i18n>StartTime}"/>
										</Column>
										<Column width="6rem" visible="{= !${device>/system/phone} }">
											<Text text="{i18n>EndTime}"/>
										</Column>
										<Column width="4rem" hAlign="Center" visible="{= !${device>/system/phone} }">
											<Text text="{i18n>DayAssign}"/>
										</Column>
								</columns>
									<items>
										<ColumnListItem>
											<cells>
												<ObjectIdentifier title="{Reqno}" text="{Zlvde}"/>
												<Text text="{AtypeDes}"/>
												<Text text="{Tprog}"/>
												<Text text="{Tptxt}"/>
												<Text text="{path: 'Begda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }}"/>
												<!--<Text text="{path: 'Endda', type: 'sap.ui.model.type.Date', formatOptions: { pattern : 'yyyy.MM.dd' }}"/>-->
												<Text text="{path: 'Beguz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"/>
												<Text text="{path: 'Enduz', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss' }}"/>
												<Text text="{= ${Dallf} === '+' || ${Dallf} === '-' ? ${Dallf} : '—' }" tooltip="{i18n>DayAssignTooltip}"/>
												<!--<ObjectStatus text="{StatsDes}" state="{parts :['Stats'], formatter:'._formatText'}"/>-->
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</IconTabFilter>
						</items>
					</IconTabBar>
				</headerContainer>
			</ObjectHeader>
		</semantic:content>
	</semantic:DetailPage>
</mvc:View>