{
  "name": "zcnhrmecn_ta",
  "version": "0.0.1",
  "private": true,
  "description": "A Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "2",
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^3.11.0",
    "nwabap-ui5uploader": "^1.2.0"
  },
  "scripts": {
    "start": "ui5 serve --port 8080 --open \"test/flpSandbox.html#zcnhrmecn_ta-tile\"",
    "start-index": "ui5 serve --port 8080 --open index.html",
    "start-local": "ui5 serve --config ./ui5-local.yaml --port 8080 --open \"test/flpSandbox.html#zcnhrmecn_ta-tile\"",
    "start-mock": "ui5 serve --config ./ui5-mock.yaml --port 8080 --open \"test/flpSandbox.html#zcnhrmecn_ta-tile\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy:abap": "node ./scripts/nwabap-deploy.js",
    "upload:abap": "npx nwabap upload"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "@sap-ux/ui5-middleware-fe-mockserver"
    ]
  }
}
